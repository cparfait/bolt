# Base dédiée aux tests d'intégration : ils EFFACENT toutes les tables entre
# chaque cas. Jamais la base de développement — le nom `bolt_test` est d'ailleurs
# vérifié au démarrage de la suite, qui refuse de tourner ailleurs.
#
#   docker exec bolt-dev-db psql -U bolt -d postgres -c "CREATE DATABASE bolt_test OWNER bolt;"
#   npm run test:integration
DATABASE_URL="postgresql://bolt:bolt@localhost:5434/bolt_test"
